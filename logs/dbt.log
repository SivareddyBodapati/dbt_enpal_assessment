  create  table "postgres"."public_pipedrive_analytics"."int_pipedrive__activities__dbt_tmp"
  
  
    as
  
  (
    -- int_pipedrive__activities.sql

with

    activities as (select * from "postgres"."public_pipedrive_analytics"."stg_pipedrive__activity"),

    activity_types as (select * from "postgres"."public_pipedrive_analytics"."stg_pipedrive__activity_types"),

    activities_and_types_joined as (
        select
            activities.*,
            activity_types.name as  kpi_name,
            case 
                when activity_types.name = 'Sales Call 1' then 'Step 2.1'
                when activity_types.name = 'Sales Call 2' then 'Step 3.1'
                else null
            end as funnel_step
        from activities
        left join activity_types using (type)
    ),

    renamed as (
        select 
            to_char(date_trunc('month', due_to), 'Month YYYY') as month,
            kpi_name,
            max(funnel_step) as funnel_step,
            count(distinct deal_id) as deals_count
        from activities_and_types_joined
        where funnel_step is not null and done = true
        group by 1, 2
    )

select *
from renamed
  );
  
